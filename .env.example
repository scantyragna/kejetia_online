# ── Kejetia Online — environment variables ─────────────────────────────
# Copy to `frontend/.env.local` for local development and set the same
# values (minus local-only ones) as environment variables on Render.
#
# Local mock mode: leave NEXT_PUBLIC_DB_MODE unset and the app runs fully
# offline against localStorage.

# ── Postgres (backend) ─────────────────────────────────────────────────
# Server-only connection string (never expose this to the browser).
#
# Neon: use the POOLED connection string (the one with `-pooler` in the
# host, e.g. ep-xxx-pooler.aws.neon.tech), NOT the direct one. Render runs
# many short-lived requests; the direct endpoint has a low connection limit
# and will start refusing connections under load. The pooled endpoint
# multiplexes safely.
#
# Local testing against a real DB: paste the same string here, set
# NEXT_PUBLIC_DB_MODE=postgres, then run `node scripts/migrate.mjs`.
DATABASE_URL=

# Client-side mode flag. Set to `postgres` in production to make the app
# talk to our own API routes (which then use DATABASE_URL). Unset = mock.
NEXT_PUBLIC_DB_MODE=postgres

# ── Maps (optional) ─────────────────────────────────────────────────────
# The app renders on free CARTO/OSRM layers without a key. Add a Google
# Maps key only if you later switch the map tiles to Google.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Backend (Render sets PORT automatically) ────────────────────────────
PORT=5000